        </mxCell>
        <mxCell id="s-buffer-check" value="" edge="1" parent="1" source="buffer" target="check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#536477;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;dashed=0;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="s-check-ordered" value="通过" edge="1" parent="1" source="check" target="ordered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#536477;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;dashed=0;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="s-ordered-play" value="" edge="1" parent="1" source="ordered" target="play" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#536477;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;dashed=0;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="s-check-stop" value="拦截 / 超时 / 异常" edge="1" parent="1" source="check" target="stop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#b85450;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.3684210526315789;entryY=0.0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="s-interrupt-stop" value="取消" edge="1" parent="1" source="interrupt" target="stop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#b85450;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;dashed=0;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="s-stop-play" value="清待播 / 停止后续" edge="1" parent="1" source="stop" target="play" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#b85450;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;labelBackgroundColor=#ffffff;dashed=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1585" y="615" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="delta" value="模型流式增量&#10;每轮生成独立标识" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#213248;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="220" width="240" height="120" />
        </mxCell>
        <mxCell id="buffer" value="私有缓冲 / 组段&#10;自然句候选 + 长度上限&#10;尾段同样送检" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#213248;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="220" width="280" height="120" />
        </mxCell>
        <mxCell id="check" value="阿里审核 + 本地策略&#10;必要上下文 / 有限超时&#10;未知结果不放行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#213248;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="750" y="220" width="280" height="120" />
        </mxCell>
        <mxCell id="ordered" value="已审核队列&#10;前序通过才释放&#10;旧轮结果丢弃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#213248;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="220" width="260" height="120" />
        </mxCell>
        <mxCell id="play" value="TTS / 屏幕&#10;按序播放与显示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#213248;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1480" y="220" width="210" height="120" />
        </mxCell>
        <mxCell id="interrupt" value="用户打断 / 新轮次&#10;取消旧轮所有待处理任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#213248;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="560" width="310" height="110" />
        </mxCell>
        <mxCell id="stop" value="停止该轮&#10;取消生成 / 清文本与音频队列&#10;故障用代答；用户打断则静默" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#213248;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="750" y="560" width="380" height="110" />
        </mxCell>
        <mxCell id="note-0" value="禁止把原始 token 直接送进播报队列。每片记录 turn_id / generation_id / seq；取消优先于迟到结果。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#213248;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="135" width="1640" height="45" />
        </mxCell>
        <mxCell id="note-1" value="先做整段审核基线，再对照验证分段模式。&#10;审核速度落后时有界缓存并暂停/结束生成；&#10;不能为减少等待而绕过护栏。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#213248;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="380" width="590" height="100" />
        </mxCell>
        <mxCell id="note-2" value="新服务：chatId / done 需按契约验证。&#10;上下文窗口、重试去重、开通权限待确认。&#10;新旧产品的 session 字段不能混用。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#213248;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="720" width="520" height="100" />
        </mxCell>
        <mxCell id="note-3" value="残余风险：已经播放的声音无法撤回；后续内容可能改变前文语义。&#10;跨片风险与长窗口不足要测试，必要场景改为整段通过后播报。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#213248;" vertex="1" parent="1">
