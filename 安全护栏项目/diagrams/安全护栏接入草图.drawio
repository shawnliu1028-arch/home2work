          <mxGeometry as="geometry" x="350" y="700" width="340" height="110" />
        </mxCell>
        <mxCell id="vendor" value="阿里云 AI 安全护栏&#10;MultiModalGuard（先联调）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#213248;spacing=10;" vertex="1" parent="1">
