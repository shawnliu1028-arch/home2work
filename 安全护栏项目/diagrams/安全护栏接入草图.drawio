          <mxGeometry as="geometry" x="1380" y="700" width="280" height="110" />
        </mxCell>
        <mxCell id="note-0" value="三个关口各有职责：内容审核不能替代车控授权与车辆状态判断。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#213248;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="120" width="1600" height="40" />
        </mxCell>
        <mxCell id="note-1" value="执行回执经检查后回到 Agent，再生成并审核播报。&#10;以真实结果说话，执行失败时不能宣称“已完成”。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#213248;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1000" y="550" width="660" height="70" />
        </mxCell>
        <mxCell id="note-2" value="拦截 / 故障：不启动或停止生成；清待播队列。&#10;使用本地已评审代答，不透出未审原文。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#213248;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="570" width="500" height="80" />
        </mxCell>
        <mxCell id="note-3" value="实线：业务主流程    虚线：检测与观测调用    紫色：护栏    黄色：支撑模块    绿色：已审内容 / 可信结果    灰色：供应商" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#213248;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="915" width="1620" height="45" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cockpit-2" name="02 流式播报门控">
    <mxGraphModel page="1" pageWidth="1740" pageHeight="1000" grid="1" gridSize="10" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="流式播报｜先缓存，审核通过后释放" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=34;fontStyle=1;fontColor=#213248;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="20" width="1640" height="60" />
        </mxCell>
        <mxCell id="subtitle" value="模型持续生成；TTS 只接收已通过的连续片段。    /    第一版同轮审核串行 · 设计建议" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=0;fontColor=#213248;" vertex="1" parent="1">
