<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="auto-compaction-flow" id="auto-compaction">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="1450">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="pi 自动压缩内部流程" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="10" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="压缩触发&#xa;越过阈值 / /compact 命令 / 溢出恢复" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="60" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="扩展钩子: session_before_compact&#xa;可取消 / 返回自定义摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="190" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="定位切分点: 从最新消息回溯&#xa;累计 token 估算至 keepRecentTokens (默认 20k)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="330" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="单个 turn 超过&#xa;keepRecentTokens?&#xa;(isSplitTurn)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="470" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="提取 messagesToSummarize&#xa;自上次压缩边界至切分点&#xa;serializeConversation 序列化&#xa;(工具结果截断至 2000 字符)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="640" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="LLM 生成结构化摘要&#xa;上次摘要作为迭代上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="800" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3s" value="拆分 turn: 提取&#xa;turnPrefixMessages&#xa;(切分点之前的 turn 前缀)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="640" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4s" value="双摘要生成并合并:&#xa;历史摘要 (此前上下文)&#xa;+ turn 前缀摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="800" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="追加 CompactionEntry&#xa;summary / firstKeptEntryId /&#xa;tokensBefore / usage&#xa;details: 累计 readFiles + modifiedFiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="960" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="重建上下文:&#xa;摘要 + firstKeptEntryId 起的消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="1110" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="继续本轮 / 下一次请求" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="1250" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="扩展返回值:&#xa;{cancel:true} 取消压缩&#xa;{compaction:{...}} 直接采用自定义摘要&#xa;默认走内置 LLM 摘要" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="190" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="切分点规则:&#xa;仅可落在 user / assistant /&#xa;bash / custom 消息&#xa;绝不切在工具结果中间" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
